{
  "name": "Protect main history and checks",
  "target": "branch",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": [
        "refs/heads/Dzhamuha-develop",
        "refs/heads/main",
        "refs/heads/develop"
      ]
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "contributor-guard",
            "integration_id": 15368
          },
          {
            "context": "windows-tests",
            "integration_id": 15368
          },
          {
            "context": "flutter-tests",
            "integration_id": 15368
          },
          {
            "context": "go-race",
            "integration_id": 15368
          },
          {
            "context": "platform-compile (linux, amd64, dropo-linux-test)",
            "integration_id": 15368
          },
          {
            "context": "platform-compile (darwin, arm64, dropo-darwin-test)",
            "integration_id": 15368
          },
          {
            "context": "clean-windows-package",
            "integration_id": 15368
          },
          {
            "context": "android-policy-tests",
            "integration_id": 15368
          },
          {
            "context": "android-scene-tests",
            "integration_id": 15368
          }
        ]
      }
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 1,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": true,
        "require_last_push_approval": true,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": [
          "merge",
          "squash",
          "rebase"
        ]
      }
    }
  ],
  "enforcement": "active"
}
